name: Universal Repository Sync

on:
  schedule:
    - cron: '0 2 * * *'  # 每天UTC时间2点检查
  workflow_dispatch:
  push:
    branches: [ main, master ]

jobs:
  universal-sync:
    runs-on: ubuntu-latest
    steps:
    - name: Checkout current repository
      uses: actions/checkout@v4
      with:
        token: ${{ secrets.GITHUB_TOKEN }}

    - name: Setup Git
      run: |
        git config --global user.name "github-actions[bot]"
        git config --global user.email "github-actions[bot]@users.noreply.github.com"

    - name: Setup Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.x'

    - name: Create sync script
      run: |
        cat > sync_script.py << 'EOF'
        #!/usr/bin/env python3
        import os
        import json
        import subprocess
        import shutil
        from pathlib import Path

        def run_command(cmd, cwd=None):
            """执行shell命令"""
            try:
                result = subprocess.run(cmd, shell=True, cwd=cwd, capture_output=True, text=True, check=True)
                return result.stdout.strip()
            except subprocess.CalledProcessError as e:
                print(f"命令执行失败: {cmd}")
                print(f"错误: {e.stderr}")
                return None

        def sync_repository(repo_config):
            """同步单个仓库"""
            repo_name = repo_config["name"]
            repo_url = repo_config["url"]
            include_files = repo_config["files"]["include"]
            exclude_files = repo_config["files"]["exclude"]
            target_dir = repo_config.get("target_dir", repo_name)
            
            print(f"正在同步仓库: {repo_name}")
            print(f"包含文件: {include_files}")
            print(f"排除文件: {exclude_files}")
            print(f"目标目录: {target_dir}")
            
            # 创建临时目录
            temp_dir = f"temp_{repo_name}"
            os.makedirs(temp_dir, exist_ok=True)
            
            try:
                # 克隆仓库（浅克隆以节省时间和空间）
                print("正在克隆仓库...")
                run_command(f"git clone --depth 1 {repo_url} {temp_dir}")
                
                # 创建目标目录
                os.makedirs(target_dir, exist_ok=True)
                
                # 处理文件
                if include_files == ["*"]:
                    # 包含所有文件，只排除指定文件
                    for root, dirs, files in os.walk(temp_dir):
                        for file in files:
                            file_path = os.path.join(root, file)
                            relative_path = os.path.relpath(file_path, temp_dir)
                            
                            # 检查是否在排除列表中
                            should_exclude = any(
                                excluded in relative_path for excluded in exclude_files
                            )
                            
                            if not should_exclude and ".git" not in relative_path:
                                target_path = os.path.join(target_dir, relative_path)
                                os.makedirs(os.path.dirname(target_path), exist_ok=True)
                                shutil.copy2(file_path, target_path)
                                print(f"复制: {relative_path} -> {target_path}")
                else:
                    # 只包含指定文件
                    for pattern in include_files:
                        if "*" in pattern:
                            # 通配符匹配
                            for root, dirs, files in os.walk(temp_dir):
                                for file in files:
                                    if file == pattern.replace("*", ""):
                                        file_path = os.path.join(root, file)
                                        relative_path = os.path.relpath(file_path, temp_dir)
                                        target_path = os.path.join(target_dir, relative_path)
                                        os.makedirs(os.path.dirname(target_path), exist_ok=True)
                                        shutil.copy2(file_path, target_path)
                                        print(f"复制: {relative_path} -> {target_path}")
                        else:
                            # 精确文件名匹配
                            file_path = os.path.join(temp_dir, pattern)
                            if os.path.exists(file_path):
                                target_path = os.path.join(target_dir, pattern)
                                os.makedirs(os.path.dirname(target_path), exist_ok=True)
                                shutil.copy2(file_path, target_path)
                                print(f"复制: {pattern} -> {target_path}")
                
                print(f"✅ 成功同步 {repo_name}")
                
            except Exception as e:
                print(f"❌ 同步 {repo_name} 失败: {e}")
            finally:
                # 清理临时目录
                if os.path.exists(temp_dir):
                    shutil.rmtree(temp_dir)

        # 主程序
        if __name__ == "__main__":
            # 读取配置文件
            with open('.github/sync-config.json', 'r') as f:
                config = json.load(f)
            
            # 同步所有仓库
            for repo_config in config["repositories"]:
                sync_repository(repo_config)
                print("-" * 50)
        EOF

    - name: Run sync script
      run: python3 sync_script.py

    - name: Commit and push changes
      run: |
        git add .
        if ! git diff --staged --quiet; then
          git commit -m "chore: auto-sync from multiple repositories [$(date +'%Y-%m-%d %H:%M')]"
          git push
          echo "✅ 已同步并推送更改"
        else
          echo "ℹ️ 没有检测到更改"
        fi
